# ===== JARVIS SETTINGS =====
# 1) REQUIRED: Gemini key (free) from https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# 2) OPTIONAL: Groq key (free, no card) from https://console.groq.com/keys
#    Gives faster + better Whisper hearing (Hindi/Hinglish). Leave blank to skip.
GROQ_API_KEY=

# Hearing engine: auto | groq | gemini | local
#  auto = Groq Whisper if key is set, else Gemini hearing (same key, nothing extra)
STT_ENGINE=auto

# Voice engine: auto = Gemini voice "Achird" first, automatic backup edge-tts voice if Gemini is busy
# (other choices: gemini | edge)
TTS_ENGINE=auto
GEMINI_VOICE=Achird
# Backup voice: hi-IN-MadhurNeural (male) or hi-IN-SwaraNeural (female)
VOICE=hi-IN-MadhurNeural
VOICE_RATE=+5%

# Your name and how Jarvis talks to you
USER_NAME=Akash

# City for the weather widget
WEATHER_CITY=Mumbai

# Wake word. true = Jarvis only answers when you say "Jarvis ..."
# false = answers to everything it hears
WAKE_WORD_ENABLED=false
WAKE_WORD=jarvis

# Brain model (leave as is)
GEMINI_MODEL=gemini-flash-latest

# OPTIONAL: Gmail send/read (free). Needs a Gmail "App Password" (see README).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: read your Google Calendar (Calendar settings > Integrate calendar > Secret address in iCal format)
GCAL_ICAL_URL=
# Optional: webcam greeting (needs opencv-python)
FACE_GREETING=false

# ---- Phone remote control (Telegram, free). Steps are in README "Phone remote".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ---- Proactive extras
PROACTIVE_BROWSING=false
# ---- Voice gate: off | pin | voiceprint | both   (see README for honest limits)
VOICE_GATE=off
VOICE_PIN=
VOICE_GATE_MINUTES=30
VOICE_GATE_THRESHOLD=0.80
